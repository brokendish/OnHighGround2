# public backend（backend-public）設定サンプル
# このファイルをリポジトリroot直下へ `.env` としてコピーして使用してください
# （docker-compose.yml の backend-public は env_file: .env を参照、required: false）。
#
# Phase 2-D: 実際にコード（app_public.py・各app/services/*.py）が参照する
# 環境変数のみを列挙する（旧版は ALLOWED_ORIGINS / LOG_LEVEL / DATABASE_URL 等、
# 実際には読まれない変数を記載していたため、Phase 2-D で実参照箇所に基づき修正した）。
#
# CORSはこのファイルではなく backend/app.properties の cors.allow_origins で
# 設定する（fail-closed、exact-origin allowlist。詳細は docs/configuration.md）。
# 標高ファイルパスも本ファイルではなく docker-compose.yml 側で
# DEM_FILE_PATH=/data_runtime/backend/elevation/elevation.tif として固定設定される。

# ---- secret（値は空のまま。設定する場合のみ記入。実キーはコミットしないこと） ----

# ODPT（公共交通オープンデータセンター）APIキー — 鉄道運行情報取得に必要（public-optional）
# https://developer.odpt.org/ でトークン取得後に設定。未設定時は鉄道運行情報機能が無効化される
# （fail-closedではなく機能自体がoptionalとして扱われる）。
ODPT_API_KEY=

# ---- non-secret（public-optional。未設定時は各サービスの既定値が使われる） ----

# ODPT APIのbase URL（既定: https://api.odpt.org/api/v4 相当。開発時の差し替え用）
# ODPT_API_BASE_URL=

# ODPT鉄道運行情報から除外するキーワード（カンマ区切り、任意）
# ODPT_EXCLUDE_KEYWORDS=

# JARTIC交通量APIのbase URL（開発時の差し替え用）
# JARTIC_TRAFFIC_BASE_URL=

# JARTIC/道路交通量をモック応答に切り替える（開発・テスト専用、"true"/"false"）
# JARTIC_TRAFFIC_USE_MOCK=false
# ROAD_TRAFFIC_USE_MOCK=false
# ROAD_TRAFFIC_API_BASE_URL=

# Martin（ベクタータイル配信）の内部URL上書き（開発時のみ）
# MARTIN_INTERNAL_URL=

# data_runtime/ のroot pathを上書きする場合（通常は変更不要）
# OHG2_DATA_RUNTIME_ROOT=

# backend/app.properties の代わりに読み込むproperties fileパスを上書きする場合
# APP_PROPERTIES_FILE=

# ---- development-only（production public composeでは絶対に設定しないこと） ----
# 両方が厳密に "true"（前後空白除去・小文字化後に一致）の場合のみ、開発用の
# docs/redoc/openapi を有効化する。production環境（docker-compose.ymlの既定profile）
# はこれらを一切設定しない。
# OHG2_DEV_MODE=
# OHG2_DEV_DOCS_ENABLED=

# 開発用routerを明示的に利用する場合だけ true を設定する（public appは登録しない）
# DEV_EARTHQUAKE_PUBLISH=false
