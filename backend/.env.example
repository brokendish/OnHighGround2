# バックエンド設定サンプル
# このファイルをコピーして .env として使用してください

# 標高データファイルのパス
DEM_FILE_PATH=/path/to/your/elevation_data.tif

# APIサーバー設定
API_HOST=0.0.0.0
API_PORT=8000

# CORS設定（本番環境では特定ドメインを指定）
ALLOWED_ORIGINS=*

# ログレベル
LOG_LEVEL=INFO

# ODPT（公共交通オープンデータ）APIキー — 鉄道運行情報取得に必要
# https://developer.odpt.org/ でトークン取得後に設定
# ODPT_API_KEY=your_odpt_consumer_key_here

# JARTIC 道路交通情報 APIキー（オプション）
# JARTIC_API_KEY=your_jartic_key_here

# データベース設定（将来的な拡張用）
# DATABASE_URL=postgresql://user:password@localhost/evacuation_db
