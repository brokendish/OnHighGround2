# ---- tests/fixtures/osm_demo/: OSRM demo fixtureのruntime成果物隔離 ----
# Phase 2-D Round 8（P2D-OSRM-FIXTURE-CONTAMINATION対応）: このfixtureは
# `.osm.pbf`source入力とMANIFEST.jsonだけを保持するread-only fixtureであるべき。
# Round 6のdemo Composeがこのdirectoryを直接rwでmountしていたため、
# osrm-extract/partition/customizeの出力（.osrm*、54 file）がここへ書き込まれ、
# candidate policyへ混入した（CODEX round 7実測）。Round 8でosrm-driving/
# osrm-walkingの出力先を専用named volumeへ分離したため通常はもう発生しない
# はずだが、手元検証等で誤って書き込まれた場合に備えた保険としてここでもignore
# する。ignoreはcandidate混入の見た目上の対症療法にすぎず、
# `tools/public_release/phase2d_release_delta_manifest.py`の
# `scan_osrm_runtime_contamination()`がgit状態と無関係にfilesystemを直接scanし、
# 1件でも実在すればcandidate生成自体をfail-closedで停止する（本ignoreの有無に
# 依存しない、常時有効なgate）。repository全体の`*.osrm*`は包括ignoreしない
# （このexact subtreeだけに限定する）。
tests/fixtures/osm_demo/**/*.osrm*

# ---- .demo_runtime: docker-compose.demo.yml専用のdata_runtime分離領域 ----
# AT-17A demo profileが使う、production data_runtime/とは完全に独立した実行時
# 領域（Martin AT-17A finding対応）。runtime-initが初回起動時にゼロから
# 所有権を確定する。中身は常にsynthetic/実行時生成物のみ。
.demo_runtime/

# ---- data_runtime: 配備済みデータ（deploy_to_runtime.sh で生成、git 管理外）----
# ディレクトリ構造（.gitkeep）と README は管理対象、データファイルは除外
# Phase 2-B.5: atomic publish用の実行時artifact（staging/versions/writer lock）。
# operator専用initializerが生成し、内容は常にsecretを含まないが、
# datasetそのもの・version世代は既存data_runtime方針と同様にgit管理外とする。
data_runtime/.staging/
data_runtime/versions/
data_runtime/.publish.lock
data_runtime/current
data_runtime/backend/
data_runtime/cache/
data_runtime/frontend/layers/
data_runtime/frontend/tiles/
data_runtime/manifests/*.json
data_runtime/manifests/*.log
data_runtime/system/config_history.json
data_runtime/system/config_overrides.json
data_runtime/simulation/*.json
data_runtime/simulation/*.md
data_runtime/simulation/screenshots/*.png
data_runtime/simulation/scenarios/*.json

# ---- frontend/layers: deploy_to_runtime.sh で同期される GeoJSON (deploy artifact) ----
frontend/layers/*.geojson
frontend/layers/*.json
frontend/layers/*/
frontend/layers/*/*/
# OSM由来の静的鉄道路線データは gitignore 例外として追跡する
!frontend/layers/railways/
!frontend/layers/railways/kanto_railways.geojson
# OSM由来の静的道路ネットワークデータは gitignore 例外として追跡する
!frontend/layers/roads/
!frontend/layers/roads/kanto_roads_main.geojson
!frontend/layers/roads/kanto_roads_tertiary.geojson
# 行政区域 (市区町村境界) データは gitignore 例外として追跡する。
# municipality_boundaries/ (全国8地方ブロック, Phase 8-B.1) は
# scripts/download/download_municipality_boundaries_nationwide.py +
# scripts/derive/simplify_municipality_boundaries.py で再生成可能だが、
# 生成に外部ネットワークアクセスが要るため、成果物 GeoJSON 自体もコミットしローカル限定にしない。
!frontend/layers/administrative/
!frontend/layers/administrative/tokyo_boundary.geojson
!frontend/layers/administrative/kanagawa_boundary.geojson
!frontend/layers/administrative/municipality_boundaries/
!frontend/layers/administrative/municipality_boundaries/*.geojson
