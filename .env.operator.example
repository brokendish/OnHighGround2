# operator専用の秘密供給ファイルのテンプレート。
# 実際の値は `.env.operator`（git管理外、.gitignoreで除外済み）へ記入すること。
# このファイル自体（.env.operator.example）には実秘密を記入しない。
#
# Phase 2-B.1で確定した fail-closed 契約（backend/app_operator.py）:
#   OPERATOR_AUTH_SECRET が未設定・空文字・空白のみの場合、
#   backend-operator の起動は非0 exit code で失敗する。
#
# Phase 2-B.3で確定したBearer認証契約（backend/app/services/operator_auth.py）:
#   全operator管理route（/api/admin/*, /api/simulation/*）は
#   `Authorization: Bearer <OPERATOR_AUTH_SECRETの値>` header必須。
#   `/operator/health` のみ匿名可の最小liveness（status/roleのみ返す）。
#   token比較はconstant-time（secrets.compare_digest）。
#   query/body/form/cookie/別headerからのtoken受理はしない。
#   認証秘密の値はログ・監査event・エラー応答のいずれにも出力しない。
#
# ローテーション手順:
#   1. 新しいランダム値を生成する（例: `openssl rand -hex 32`）。
#   2. .env.operator を更新する。
#   3. `docker compose --profile operator up -d --force-recreate backend-operator`
#      で再起動する（再起動後、旧token での操作は即座に401となる）。
#   4. operator UI・自動化スクリプト等、tokenを保持する全クライアントを
#      新しい値へ更新する。

OPERATOR_AUTH_SECRET=

# operator serviceのhost publish先ポート番号（host_ipは127.0.0.1にリテラル固定、
# docker-compose.yml側で変更不可。ここで変更できるのはポート番号のみ）。
# 未設定時の既定値は 18100（docker-compose.yml参照）。
OPERATOR_HOST_PORT=18100
